# Copy to .env.local and fill in. All values below are placeholders.

# Supabase (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
# Server only: admin API, crons, push. Never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=your-secret-or-service-role-key

# Protects the Vercel cron routes (/api/keepalive, /api/rates/daily)
CRON_SECRET=change-me

# LLM providers used by the AI guide (server only; at least one)
NVIDIA_API_KEY=
GROQ_API_KEY=
GROQ_CHAT_MODEL=
# Optional: web search in the chat
TAVILY_API_KEY=

# Web Push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
